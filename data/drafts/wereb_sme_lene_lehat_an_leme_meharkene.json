  "title": "",
  "wereb": true,
  "ti": {
    "lines": [
      "እስመ ለነ ለኃጥኣን ለእመ መሓርከነ",
      "ውእተ ኣሚረ ትሰመይ መሐሬ /2/",
      "ወለጻድቃንሰ እምግባሮሙ ትምሕሮሙ",
      "ወትዔስዮሙ በከመ ጽድቆሙ /2/",
      "ኣይትፈለየና /2/ ሓይልኻ ሃበና /2/"
    ]
  },
  "ti_ro": {
    "lines": [
      "Sme lene lehat'an leme meharkene",
      "Wte amire tsemey mehere /2/",
      "Welets'adqanse mgbaromu tmhromu",
      "Wet'esyomu bekeme ts'dqomu /2/",
      "Aytfeleyena /2/ haylkha habena /2/"
    ]
  },
