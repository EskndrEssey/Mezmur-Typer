  "ti": {
    "lines": [
      "ውእቱ ሊቆሙ ለመላእክት",
      "ወመልኣኮሙ ቅዱስ ሚካኤል",
      "ልብሱ ዘመብረቅ ዓይኑ ዘርግብ ሊቀ መላእክት"
    ]
  },
  "ti_ro": {
    "lines": [
      "Wtu liqomu lemelakt",
      "Wemelakomu qdus mikael",
      "Lbsu zemebreq 'aynu zergb liqe melakt"
    ]
  },
