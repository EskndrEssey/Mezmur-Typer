    "lines": [
      "Iyaqem wehena abokhn adekhn",
      "Bete gziebher keydom",
      "Mebts''a zhabukhi mena kab semayat",
      "Amlakh zewredelki",
      "Fts'mt dngl nts'ht maryam nskhi",
