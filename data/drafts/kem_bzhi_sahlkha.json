      },
      {
        "verse": 2,
        "lines": [
          "ቅድሜኻ ወዲቕና ክንልምን ነዓኻ/2/",
          "ጐይታ መሓረና ምውዳቕና ርኢኻ/2"
        ]
      }
    ]
  },
  "ti_ro": {
    "chorus": [
      "Kem bzhi sahlkha amlakh meharena/2/",
      "Kemti mhretka’wn yqreta habena/2/",
      "Ants'hana gwayta kab key bedelna/2/",
      "Neza ts'elmat 'alem keykewn 'dlna/2/"
