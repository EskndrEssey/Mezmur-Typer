  "lyrics": {
    "en": "",
    "ti": "[[chorus]]\nአምላኮሙ ለክርስቲያን ተመሲሎ ሰብአ መጽአ ኃቤየ\nወይቤላ ቅዱስ ጊዮርጊስ\nኣንሰ ኢኮንኩ አምላከ ኣላ ገብረ አምላክ ኣነ\n[[/chorus]]",
    "ti_ro": "[[chorus]]\nʾAmlakomu lekristiyan temesilo sebʾa metsʾa habeye\nWeybela qidus Giyorgis\nʾAnse ʾikonku ʾamlake ʾala Gebre ʾamlak ʾane\n[[/chorus]]",
