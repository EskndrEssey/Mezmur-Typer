{
  "id": 558,
  "title": "",
  "wereb": true,
  "ti": {
    "lines": [
      "ጾምናን ጸሎትናን ተቐበለልና",
      "ባህ ዘብለካ ይኹነልና",
      "ንኸይንሰዓር ሓይልኻ ሃበና",
      "ሓፊሩ ይመለስ ይውደቕ ጸላኢና"
    ]
  },
  "ti_ro": {
    "lines": [
      "Ts'omnan ts'elotnan teqebelelna",
      "Bah zebleka ykhunelna",
      "Nkheynse'ar haylkha habena",
      "Hafiru ymeles ywdeq ts'elaina"
    ]
  },
