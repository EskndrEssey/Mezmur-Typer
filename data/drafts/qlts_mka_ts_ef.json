{
  "id": 22,
  "title": "ቅልጽምካ ዕጸፍ",
  "ti": {
    "chorus": [
      "ቅልጽምካ ዕጸፍ ዝብለካ መን’ዩ",
      "ምድሓንካ ግደፍ ዝብለካ መን’ዩ",
      "እንተኸፍኣኩም’ቶም ኣሳደድተይ",
      "ጸኒዐ ኣለኹ ብኣኻ ጐይታይ",
      "ሕይወት ክመልእ ተሪፉ ሞተይ",
      "እቲ ጸላም ድነ ክእለ ካባይ",
      "እንታይ ኣሕዘኖም እቶም ሰዱቓውያን",
      "ንዘይዕንቀፍ ናይ ጐይታ ምድሓን"
    ],
    "verses": [
      {
        "verse": 1,
        "lines": [
          "ኣብ ቤተ ሳይዳ ሕማመይ ደርብየ",
          "እንተ ተንሳእኩ ሓይሊ ደሪበ",
          "ብሰንበት ንዓይ ፈዊሱኒ ኢልኩም",
          "ንምንታይ ንዕኡ ንሞት ፈረድኩም",
          "ስምኦን ተኣለ ይከፈት ቤቱ",
          "ይኣክል ቅንእኻ ኣብቲ ምሕረቱ",
          "ሓጢኣተይ ጐይታ ተሓደገለይ",
          "እንታይ ትጉዳእ በቲ ንብዓተይ"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ዓይኒ ፈጢሩ እንተርኣየኒ",
          "ምስቶም ዝርእዩ እንተጸምበረኒ",
          "ንምንታይ ገጽኩም ብሓዘን ጠቀረ",
          "ኤልሻዳይ ጐይታ ስለዘፍቀረ",
          "ይከፈት ቤቱ ክንመላለስ",
          "እቲ ፈቃር ጐይታ ኣባና ይንገስ"
        ]
      }
    ]
  },
