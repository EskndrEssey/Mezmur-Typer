          "ኣይጽልምትን’ዩ  ከቶ ሕይወትና",
          "ወድኺ ከሎ ብርሃን ጸሓይና"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ሰኣሊ ለነ ሰላም ለኪ",
          "ተማሕጸነ በኪዳንኪ",
          "ንዒ ርግብየ ምስለ ወልድኪ",
          "ሰማይ ወምድር ይዌድሱኪ"
        ]
      }
    ]
