  "ti": {
    "chorus": [
      "ጉንዲ ናይ ወይኒ መስተ ናይ ሕይወት",
      "መገዲ ሓቂ ጐይታ ናይ ጎይቶት",
      "ኣባኻ ምንባር መድኃኔ ዓለም",
