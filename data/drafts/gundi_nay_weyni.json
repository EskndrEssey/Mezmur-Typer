    "verses": [
      {
        "verse": 1,
        "lines": [
          "ንስኻ ዋናይ ኣይናወጽን",
          "ተኹላ እንተመጸ ኣይፈርሕን",
          "ስለ ዝፈልጥ ከምተፍቅረኒ",
          "ኣይፈርሕን'የ ከይትገድፈኒ/2/",
          "ጽልግልግ ይኹን ይበርትዕ ጸልማት",
          "ባሕሪ ይናወጽ ይንደድ'ቲ እሳት",
          "ካብ መን ክፈርሕ ኣይሰግእን",
          "ወላዲ ናተይ ኣይታኸስን /2/"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ብጾር ናይ ዓለም እትሳቐዩ",
          "ንዑ ኣዕርፉ ቃሉ ስተዩ",
          "ጾርኩም ሃብዎ ክሽከመልኩም",
          "ኣይትጨነቑ ምስኡ ይሕሸኩም/2/"
        ]
      }
