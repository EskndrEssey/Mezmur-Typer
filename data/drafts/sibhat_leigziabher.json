  "lyrics": {
    "en": "",
    "ti": "[[chorus]]\nስብሐት ለእግዚአብሔር ኪያነ ዘፈጠረ ከመ ናምልኮ\nስብሐት ለማርያም እመ አምላክ እግዝእትነ ወመድኃኒትነ\nስብሐት ለመስቀለ ክርስቶስ ዕፀ መድኃኒት ኃይልነ ወጸወንነ።\n[[/chorus]]",
    "ti_ro": "[[chorus]]\nSibhat leʾigziʾabher kiyane zefet'ere keme namliko\nSibhat lemaryam ʾime ʾamlak ʾigziʾitne wemedhanitne\nSibhat lemesqele Kristos ʿitse medhanit hayline wetsewenne.\n[[/chorus]]",
