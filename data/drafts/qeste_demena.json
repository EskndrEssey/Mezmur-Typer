    "verses": [
      {
        "verse": 1,
        "lines": [
          "ንዜማታትኪ ኣሰሊፉና",
          "ከተማ ዓወት ከተማ ዑቕባ",
          "መሊኡ ይፈሰስ ጸጋ ምልጃኺ",
          "ክብርና በዝሐ እንከነኽብረኪ",
          "ኣብሲሩ መልኣኽ ዘደንቕ ነገር",
          "ከም ትወልዲ ወልድ በቲ ዘይምርመር",
          "ጐይታ ብልቡ ዝሰኣለኪ",
          "ኵሉ ፍጥረት ብጽእት ኢሉኪ"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ፍቕሪ እዩ’ሞ ዕላማኡ ንዓና",
          "ወዲ እግዚአብሔር ኣብ እሙን ጓሳና",
          "ስለ ኣባጊዑ ምስ መጸ መድኅን",
          "ሓረግ ዝኾኖ ከማኺ የለን"
        ]
      }
    ]
  },
