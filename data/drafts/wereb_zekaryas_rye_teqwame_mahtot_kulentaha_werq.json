  "title": "",
  "wereb": true,
  "ti": {
    "lines": [
      "ዘካርያስ ርእየ ተቅዋመ ማህቶት ኩለንታሃ ወርቅ",
      "በየማና ወበጸጋማ ኣዕጹቀ ዘይት",
      "ነቢያት ይትፌስሑ ሓዋርያት ይትሃሰዩ በውስቴታ",
      "ወዳዊት ይዜምር በውስተ ማሕፈዲሃ"
    ]
  },
  "ti_ro": {
    "lines": [
      "Zekaryas rye teqwame mahtot kulentaha werq",
      "Beyemana webets'egama a'ts'uqe zeyt",
      "Nebiyat ytfeshu hawaryat ythaseyu bewsteta",
      "Wedawit yzemr bewste mahfediha"
    ]
  },
