    "verses": [
      {
        "verse": 1,
        "lines": [
          "ሓሙሽተ ሽሕን ሓሙሽተ ሚእትን",
          "ናይ መርገም ዓመታት ናይ ፍዳ ዘመን",
          "ክርስቶስ ምስ መጸ ፍጹም ተቐይሩ",
          "ግዝኣት ናይ ዲያብሎስ ኣሰይ ተሳዒሩ",
          "ኣብ ክንዲ ጻድቕ የለን ዝመውት",
          "ስለ ፈታዊኡ ይህሉ ምናልባት",
          "ጐይታ ግና ጌና ኣብ ኃጢኣት ከለና",
          "ስለ ዘፍቀረና ሞይቱ ኣብ ክንዳና"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ንዝገፍዓና ገፊዑልና ጐይታ",
          "ሰላም እናብሰረ ንሲኦል ዘመታ",
          "ሓዘን የለን ሕጂ ኮይኑ’ዩ ዕልልታ",
          "ዝተዓጽወት ገነት ኣሰይ ተኸፊታ"
        ]
      }
    ]
