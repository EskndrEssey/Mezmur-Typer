{
  "id": 553,
  "title": "",
  "wereb": true,
  "ti": {
    "lines": [
      "ደብረ ኤፍራታ ማሕበርና",
      "እግዚአብሔር ባርኸልና /2/",
      "እምነት ተስፋ ፍቕሪ ሕያውነት ትሕትና",
      "ሓሙሽተ ኣዕኑድ’የን ምስጢር ሃይማኖትና",
      "ንኹለን ስድራታት ጐይታ ባርኸልና",
      "ብቕዱስ መንፈስካ ሓደ ግበረና"
    ]
  },
  "ti_ro": {
    "lines": [
      "Debre efrata mahberna",
      "Gziebher barkhelna /2/",
      "Mnet tesfa fqri hyawnet thtna",
      "Hamushte a'nud’yen mst'ir haymanotna",
      "Nkhulen sdratat gwayta barkhelna",
      "Bqdus menfeska hade gberena"
    ]
  },
