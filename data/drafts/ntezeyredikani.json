    "verses": [
      {
        "verse": 1,
        "lines": [
          "Yeshka'llu’lewu kulom zrayuni",
          "Zedhneka amlakh abey alo ybluni",
          "Nus’ye felt' hasekha nay mdri",
          "Bbrtu' qlts'mka gwaytay adhneni",
          "Amanuel amlakhey ts'elotey sm'ani",
          "Awyatey’wn ts'nbel qelt'ifka rdani",
          "Nztets'eg'ukha mets'egi'om ikha",
          "Netom shgurat’wn tbets'hom ba'lkha"
        ]
