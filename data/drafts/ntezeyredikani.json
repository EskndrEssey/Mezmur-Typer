{
  "id": 451,
  "title": "እንተዘይረዲእካኒ",
  "ti": {
    "chorus": [
      "ተዘይረዲእካኒ ንበይነይ’የ",
      "ኣማኑኤል ጐይታይ/2/",
      "እልምነካ ኣለኹ",
      "ኣይትርአ ድኽመተይ",
      "ጐይታይ ኵሉ ጊዜ ናባኻ የእዊ ኣነ",
      "ብሰንኪ ሓጢኣተይ ዕረፍቲ ስኢነ",
      "ኣቦታት ለሚኖም መዓስ ኣሕፊርካዮም",
      "ስለዝኣምኑኻ ካብ ሞት ኣድኂንካዮም"
    ],
    "verses": [
      {
        "verse": 1,
        "lines": [
          "የሽካዕልሉ’ለዉ ኩሎም ዝርኣዩኒ",
          "ዘድሕነካ ኣምላኽ ኣበይ ኣሎ ይብሉኒ",
          "ንኡስ’የ እፈልጥ ሓሰኻ ናይ ምድሪ",
          "ብብርቱዕ ቅልጽምካ ጐይታይ ኣድሕነኒ",
          "ኣማኑኤል ኣምላኸይ ጸሎተይ ስምዓኒ",
          "ኣውያተይ’ውን ጽንበል ቀልጢፍካ ርድኣኒ",
          "ንዝተጸግዑኻ መጸጊዖም ኢኻ",
          "ነቶም ሽጉራት’ውን ትበጽሖም ባዕልኻ"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ኣብ ጊዜ ጸገመይ ረዳኢየይ ኢኻ",
          "ተርክበለይ ኢኻ ጸሎተይ ሰሚዕካ"
        ]
      }
    ]
  },
  "ti_ro": {
    "chorus": [
      "Tezeyredikani nbeyney’ye",
      "Amanuel gwaytay/2/",
      "Lmneka alekhu",
      "Aytre dkhmetey",
      "Gwaytay kwlu gize nabakha yewi ane",
      "Bsenki hat'iatey 'refti sine",
      "Abotat leminom me'as ahfirkayom",
      "Slezamnukha kab mot adhinkayom"
