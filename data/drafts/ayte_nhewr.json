{
  "id": 421,
  "title": "ኣይቴ ንሐውር",
  "ti": {
    "chorus": [
      "ኣይቴኑ አሐውር እመንፈስከ ወአይቴ እጐይይ እምቅድመ ገጽከ",
      "እመኒ ዐረጉ ውስተ ሰማይ ህየኒ አንተ"
    ],
    "verses": [
      {
        "verse": 1,
        "lines": [
          "አይቴ ነሐውር ወአይቴ ንጐይይ እምቅድመ ገጽከ",
          "መነ ንሰምዕ ወመነ ናጸምዕ እንበለ ቃልከ",
          "በድምፀ ነጐድጓድ ወበድምፀ ማዕበል",
          "ኃይለከ ከሠትከ በግብርከ ልዑል"
        ],
        "possible_page_split": true
      },
      {
        "verse": 2,
        "lines": [
          "አባግዐ መርዔት በኃይል ገፋዕኩ",
          "በቅትለቶሙ ለጻድቃን ሠመርኩ",
          "ሳውል ተመየጥ ብህልከኒ ሊተ",
          "ወበትእዛዝከ ኃይልከ ተከሥተ",
          "በብሂሎትየ ኢይክሕደከ",
          "አላ እመውት በስቃይ ምስሌከ",
          "ኢተቈጥዐ ወኢተቀየመ",
          "አመ ክሕድክዎ ሰምዓኒ ዳግመ"
        ]
      },
      {
        "verse": 3,
        "lines": [
          "ሕይወተ ዚአነ ለደቀ ቤትከ",
          "አመ ተሌለየ እምነ ፍቅርከ",
          "እስመ ከመ ዓሣ ዘእንበለ ባሕር",
          "አልብነ ሕይወት በሰማይ ወምድር"
        ]
      },
      {
        "verse": 4,
        "lines": [
          "መስቀል መድኃኒትና"
        ]
      }
    ]
  },
  "ti_ro": {
    "chorus": [
      "Aytenu ehewr menfeske weeyte gwayy mqdme gets'ke",
