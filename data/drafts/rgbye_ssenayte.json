{
  "id": 213,
  "title": "ርግብየ ሠናይተ",
  "ti": {
    "chorus": [
      "ይቤላ ይቤላ ወይቤላ ንዒ /2/",
      "ርግብየ ሠናይት",
      "በስመኣብ ወወልድ ወመንፈስቅዱስ ወይቤላ ንዒ",
      "ይደሉ ስባሔ ለሥሉስ ቅዱስ       ወይቤላ ንዒ",
      "ውዳሴ ወግናይ ዓሰርቱ ቃላት      ወይቤላ ንዒ",
      "ኣስተማሰልናኪ ተቅዋመ ማህቶት   ወይቤላ ንዒ"
    ],
    "verses": [
      {
        "verse": 1,
        "lines": [
          "ዳዊትኒ ይቤ እግዚኦ እግዚኦ         ወይቤላ ንዒ",
          "ሓይልኪ ፍጹም ለጽልመት ዘሞኦ   ወይቤላ ንዒ",
          "ዳዊትኒ ይቤ ኣኮኑ ኣኮኑ",
          "ወይቤላ ንዒ"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ቃልኪ እምየ መናዝዝ ለኵሉ      ወይቤላ ንዒ",
          "ዳዊትኒ ይቤ ፍካሬ ፍካሬ             ወይቤላ ንዒ",
          "ለልዑል ኣዶናይ ዘኮንኪ ማህደረ     ወይቤላ ንዒ",
          "ክበበ ገጽኪ ከመ ወርኀ ሰማይ       ወይቤላ ንዒ",
          "ኣዕይንትኪ ብሩህ እምኮከበ ሰማይ   ወይቤላ ንዒ"
        ]
      },
      {
        "verse": 3,
        "lines": [
          "ለክብረ ዚኣኪ እምርሑቅ መጽኡ",
          "ወይቤላ ንዒ"
        ]
      },
      {
        "verse": 4,
        "lines": [
          "ውርዝዋን ደናግል ከመ ያንፈርዕጹ",
          "ወይቤላ ንዒ"
        ]
      },
      {
        "verse": 5,
        "lines": [
          "ጥበበ ቃልኪ ጎስዐ ልሳንየ",
          "ወይቤላ ንዒ"
        ]
      },
      {
        "verse": 6,
        "lines": [
          "ትፍስሕተ ወሃሴት ኮነኒ ሲሳየ",
          "ወይቤላ ንዒ",
          "ዖድክዋ ለዓለም ኃጣእኩ ከማኪ     ወይቤላ ንዒ",
          "በታሕተ እግዚእ መኑ ይመስለኪ     ወይቤላ ንዒ",
          "ራእይኪ ሰናይ መድኅነ ዕዉር       ወይቤላ ንዒ",
          "ኢይበጽሖ ኣነ ክብርኪ በመዝሙር   ወይቤላ ንዒ"
        ]
      }
    ]
  },
  "ti_ro": {
    "chorus": [
      "Ybela ybela weybela n'i /2/",
      "Rgbye Ssenayt",
      "Besmeab weweld wemenfesqdus weybela n'i",
      "Ydelu sbahe lesslus qdus       weybela n'i",
      "Wdase wegnay 'asertu qalat      weybela n'i",
      "Astemaselnaki teqwame mahtot   weybela n'i"
