    "verses": [
      {
        "verse": 1,
        "lines": [
          "Dawitni ybe gzio gzio         weybela n'i",
          "Haylki fts'um lets'lmet zemoo   weybela n'i",
          "Dawitni ybe akonu akonu",
          "Weybela n'i"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "Qalki mye menazz lekwlu      weybela n'i",
          "Dawitni ybe fkare fkare             weybela n'i",
          "Lel'ul adonay zekonki mahdere     weybela n'i",
          "Kbebe gets'ki keme werhe semay       weybela n'i",
          "A'yntki bruh mkokebe semay   weybela n'i"
        ]
      },
      {
        "verse": 3,
        "lines": [
          "Lekbre ziaki mrhuq mets'u",
          "Weybela n'i"
        ]
      },
      {
        "verse": 4,
        "lines": [
          "Wrzwan denagl keme yanfer'ts'u",
          "Weybela n'i"
        ]
      },
      {
        "verse": 5,
        "lines": [
          "T'bebe qalki gos'e lsanye",
          "Weybela n'i"
        ]
      },
      {
        "verse": 6,
        "lines": [
          "Tfshte wehaset koneni sisaye",
          "Weybela n'i",
          "'Odkwa le'alem hat'aku kemaki     weybela n'i",
          "Betahte gzi menu ymesleki     weybela n'i",
          "Rayki senay medhne 'wur       weybela n'i",
          "Iybets'ho ane kbrki bemezmur   weybela n'i"
        ]
      }
    ]
