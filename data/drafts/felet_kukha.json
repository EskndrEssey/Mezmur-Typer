      "እዚ እዩ ኣምላኽካ ኣምልኮ በሉኒ",
      "ፈጣሪ ናይ ጸሓይ በጃኻ ርድኣኒ",
      "ኢለ ምስ ለመንኩ ኣለኹ ኢልካኒ"
    ],
    "verses": [
      {
        "verse": 1,
        "lines": [
          "ኣጽዋረይ ኣልዒለ ስንቀይ እውን ቋጺረ",
          "ንዓኻ ከጥፍእ ኢለ ተላዒለ",
          "ንጌጋ መንገደይ ንቕኑዕ ለዊጥካ",
          "ብርሃን ኣርኢኻኒ ነቲ ብሩህ ገጽካ",
          "ኣሕዛብ ክምስክሩ ሕሙማት ዕውራት",
          "ኩሎም ከድኑቑኻ ክሰምዑ ብስራት",
          "ቁመት ሓጺሩኒ ኣብ ሳግላ ሓዂረ",
          "ሎምስ ረኺበካ ብዙሕ ተማሂረ"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ኣበይ ኣሎ ኣምላኸይ ኣበይ እዩ ዝርከብ",
          "ኣብ ደገ ሰላሙ ኣብቲ ናቱ መቕደስ",
          "ሥጋኡ ቆሪሱ ክቡር ደሙ ኣፍሲሱ",
          "ወትሩ ይዕድል’ዩ ንዑ ተቐደሱ"
        ]
      }
    ]
  },
  "ti_ro": {
