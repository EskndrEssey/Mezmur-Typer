        "lines": [
          "መምህር ናተይ ኣብ ናብራ ሕይወተይ",
          "ብቕድስና ቃሉ የስተኻኽል ጉዕዞይ",
          "መራሒ ናተይ ኣብ ኵሉ መንገደይ",
          "ብእኡ ይትካእ በይነይ ምትራፈይ",
          "ኣብቲ መቕደሱ ንዘቖመኒ",
          "ካብ ውድቀተይ’ውን ዘተንስኣኒ",
          "ሓንቲ ኣይስኣኖን ይድግፈኒ",
          "ኵሉ ክመልእ ተስፋ ኣለኒ"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ንደቁ መገዲ ባዕሉ’ዩ ዘርኢ",
          "ንንእስነተይ እንከይነዓቐኒ",
          "ሰላም መልኦ ኵሉ ጉዕዞይ",
          "ተመስገን ክበር ልዑል ጐይታ"
        ]
      }
    ]
