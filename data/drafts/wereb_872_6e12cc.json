  "langs": {
    "ti": {
      "title": "ድንግል ሽዑ ጊዜ (2) በርትዐ ሓዘንኪ",
      "zemari": "",
      "lyrics": "[[chorus]]\nድንግል ሽዑ ጊዜ (2) በርትዐ ሓዘንኪ\nኣብ ልዕሊ መስቀል ክጸዓር ወድኺ\nከልቢ ተገፊዑ ሽዑ ጊዜ ኣስትይኒ ክብለኪ\nብወርቃዊ ሳእኒ ዘስተኺ ካብ ማይኪ (2)\nክሰጉኦ ኣንስቲ ሽዑ ጊዜ ከብድኺ በሊዑኪ\nንፍጡር ሓዚንኪ ዝስተ ዝሃብኪ (2)\nጸማእኩ እናበለ ሽዑ ጊዜ ክግዕር ወድኺ\nከመይ’ሉ ከኣሎ ናይ ወላድ ከብድኺ (2)\nክትሓዝኒ ክትበኽዪ ሽዑ ጊዜ ሓዘን ክውሕጠኪ\nመነመን ነበሩ ዘጸናንዑኺ (2)\nክትበኽዪ ርእዩኪ ሽዑ ጊዜ ራህሪሁ ልብኺ\nከጸናንዓኪ ንዮሐንስ ሃበኪ (2)\n[[/chorus]]"
    },
