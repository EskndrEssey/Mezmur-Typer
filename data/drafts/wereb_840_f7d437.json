  "langs": {
    "ti": {
      "title": "ከም ብዝሒ በደለይ ተኾይኑ ቅጽዓተይ",
      "zemari": "",
      "lyrics": "[[chorus]]\nከም ብዝሒ በደለይ ተኾይኑ ቅጽዓተይ\nኣይውዳእን’ዩ ተዘርዚሩ ኃጢአተይ(2)\nክምለስ እናበልኩ እብል ሎሚ ጽባሕ\nበደለይ ሓዲገ ክምለስ ናባኻ\nእንታይ ክምልስ’የ ዝመጽኣሉ ዕለት(2)\nኣይሰርሕን’ዩ ሽዑ ኣውያት ብኽያት\nመሓሪ ኢኻ’ሞ ንዝበደሉኻ\nይቕረ በሃሊ ኢኻ ንዝለመኑኻ\nይቕረ በለኒ’ሞ ክረክብ ጸጋኻ\nዓመጸኛ ልበይ ድሕሪት ከይመልሰኒ(2)\nልመናይ ስምዓዮ ጐይታይ መሓረኒ\n[[/chorus]]"
    },
