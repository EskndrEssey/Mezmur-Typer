    "verses": [
      {
        "verse": 1,
        "lines": [
          "ንሱ’ዩ ኣምላኽና መድኅን ናይ ሕይወትና",
          "ዝተወሃሃደ ለቢሱ ሥጋና",
          "ፍጡር’ዩ ኣይንብልን ከምቶም ዝዓሸዉ",
          "ኣብ ዕንደራ ሰይጣን ፍጹም ዝዓለዉ",
          "ነስተውዕል ኵልና ዝተኸፍለ ዋጋ",
          "ፈንቂሉ ዘውጽኣና ካብ ሰይጣን መንጋጋ",
          "ተፈዊስና ኢና ቁስልና ሃሲሱ",
          "ብመከራ ጐይታ ፍጹም ተደቢሱ"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ኣማላዲ ኣይኮነን ኣምላኽ’ዩ ዘልዓለም",
          "ንርእሱ ዘትሓተ ክህበና ሰላም",
          "ልቦና ግበሩ ኣይትጠራጠሩ",
          "ኣብ ቅኑዕ ጎደና ብጥበብ ንበሩ"
        ]
      }
    ]
