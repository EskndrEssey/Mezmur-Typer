  "id": 756,
  "title": "",
  "wereb": true,
  "ti": {
    "lines": [
      "ቤተክርስቲያና ቀድስና ነቶም ንኣምነኪ ሓይልኺ ሃብና",
      "ጽዮን ኣዴና በረኸትኪ ኣይፈለየና",
      "በከመ ተጋባእክሙ በዛቲ ዕለት /2/",
      "ከማሁ ያስተጋብእክሙ በደብረ ጽዮን ቅድስት",
      "ወበኢየሩሳሌም ኣግዓዚት /2/"
    ]
  },
  "ti_ro": {
    "lines": [
      "Betekrstiyana qedsna netom namneki haylkhi habna",
      "Ts'yon adena berekhetki ayfeleyena",
      "Bekeme tegabakmu bezati 'let /2/",
      "Kemahu yastegabkmu bedebre ts'yon qdst",
      "Webeiyerusalem ag'azit /2/"
    ]
  },
