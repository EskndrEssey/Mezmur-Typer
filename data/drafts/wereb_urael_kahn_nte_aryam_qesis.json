  "ti": {
    "lines": [
      "ዑራኤል ካህን እንተ ኣርያም ቀሲስ",
      "ባርካ ለመቅደስከ በመስቀለ ክርስቶስ",
      "ከመ ባረካ ለምድር በደሙ ቅዱስ"
    ]
  },
  "ti_ro": {
    "lines": [
      "'Urael kahn nte aryam qesis",
      "Barka lemeqdeske bemesqele krstos",
      "Keme bareka lemdr bedemu qdus"
    ]
  },
