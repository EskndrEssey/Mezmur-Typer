    "verses": [
      {
        "verse": 1,
        "lines": [
          "ማይ እንተመልአ እቲ መርከብና",
          "እሾኽ እንተኾነ መንገድና",
          "ኣይንሽበርን ተ’ኣሚና",
          "ኣምላኽ ንኣኻ እንተ ሒዝና",
          "ምውሓድ ምብዛሕ ፈሊጥና ኢና",
          "ምውታን ክንመስል ሕያዋን ኢና",
          "ንጸላእትና ስዒርካልና",
          "ናይ ፈጣሪና ናትካ ኴንና"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ተተሰደድኩ ካብ ሃገረይ",
          "እንተደኸመ እቲ ጉልበተይ",
          "ኣምላኽ ብኣኻ ሰብ ኮይነ’የ",
          "ንወገነይ`ውን ተሪፈየ"
        ]
      }
    ]
