{
  "id": 117,
  "title": "ፈትዩና እዩ’ሞ",
  "ti": {
    "chorus": [
      "ፈትዩና እዩ’ሞ ዳግም ኣይጸልኣናን",
      "ርእዩና’ዩሞ ከቶ ኣይርስዓናን",
      "የለን ዝመስሎ እሙን ቅዱስ ጐይታ",
      "ምሳና እዩ ክሳብ መወዳእታ",
      "ካብ ስፍራ ጸልማት ካብ ናይ ዓለም ከውታ",
      "እናጸውዐ ናብ ብርሃን ወጋሕታ",
      "ሕዝቡ ከይኮንና ሕዝቡ’ዩ ገይሩና",
      "እስራኤል ዘነፍስ ምሕረት ረኺብና ኢና"
    ],
    "verses": [
      {
        "verse": 1,
        "lines": [
          "ጥበበኛታት ንኸሕፍር ኢሉ",
          "ሥጋ ለቢሱ ንዓና መሲሉ",
          "ብሞት ኣምላኽና ሕይወት ረኺብና ኢና",
          "ዕልል ንበል ነጻነት ረኺብና",
          "‘ተጠምየ መግበይ ምስ ዝጸምእ መስተይ",
          "ከይዓርቕ ልብሰይ ከይሽገር ምርኩሰይ",
          "ሓይለይ ብርትዐይ መጽንዕየይ እዩ",
          "ቅልጽም ጸላእተይ ሰይርዎ ርኣዩ"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ቀስቱ ኣልዒሉ ጸላኢ እንተ መጸ",
          "ከጥፍኣና ኢሉ ውዲት ‘ተሓንጸጸ",
          "ዳዊት ክዕወት ንጎልያድ ዘሕፈሮ",
          "ኣምላኽ እስራኤል ኣብ መንጎና ኣሎ"
        ]
      }
    ]
  },
