{
  "id": 431,
  "title": "ኣባ ኣቡነ ሰላማ",
  "ti": {
    "chorus": [
      "ሰባኺ ወንጌል ብርሃን ኢትዮጵያ",
      "ኣባ ኣቡነ ሰላማ ክቡር ቅዱስ ግብሩ",
      ">>     >>       ኣነስ ኣምሂሩኒ",
      ">>     >>      ስበኽ ስበኽ ኢሉ",
      ">>     >>      ፍቕሩ ቀስቂሱኒ",
      "ኣባ ኣቡነ ሰላማ"
    ],
    "verses": [
      {
        "verse": 1,
        "lines": [
          "ኣምላከ ሰላማ ዘልዓለም ይወደስ",
          "ብነፍሲ ብስጋይ ፈጺመ ክፍወስ",
          "ኣባ ኣቡነ ሰላማ ዝኽርኻ ዝዘከረ",
          ">>     >>      ስምካ ዝጸውዐ",
          ">>     >>      ገድልኻ እንትንበብ",
          ">>     >>      ብልቢ ዝሰምዐ",
          "ኣባ ኣቡነ ሰላማ"
        ]
      },
      {
        "verse": 2,
        "lines": [
          "ኣብ ምድራዊ ሕይወት ይስዕር ፈተና",
          "ምስኡ ስለዘሎ ኣምላከሰላማ",
          "ኣባ ኣቡነ ሰላማ  ይርዕዱ  ኣጋንንቲ",
          ">>     >>      እንክጽዋዕ ስምካ",
          ">>     >>       ተኣምር ይፍጸም",
          ">>     >>      ብሕያው ገድልኻ",
          "ኣባ ኣቡነ ሰላማ"
        ]
      },
      {
        "verse": 3,
        "lines": [
          "ሰላማ ምስጢሩ ንዝገለጸልካ",
          "እግዚኣብሔር ይመስገን እንቋዕ ደስ በለካ",
          "ኣባ ኣቡነ ሰላማ ገዳምካ ዝመጸ",
          ">>     >>      ብፍጽምት እምነት",
          ">>     >>      ብኽብሪ ይነብር",
          ">>     >>      ዘልዓለም ሕይወት",
          "ኣባ ኣቡነ ሰላማ"
        ]
      },
      {
        "verse": 4,
        "lines": [
          "ሓዘን ዝኸበቦ ተስፋ ዝቖረጸ"
        ]
      }
    ]
  },
  "ti_ro": {
