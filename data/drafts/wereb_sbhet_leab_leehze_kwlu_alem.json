  "id": 554,
  "title": "",
  "wereb": true,
  "ti": {
    "lines": [
      "ስብሐት ለኣብ ለአኅዜ ኵሉ ዓለም",
      "ስብሐት ለወልድ ለገባሬ ኵሉ ፍጥረት",
      "ስብሐት ለመንፈስቅዱስ ለዘያርሁ ክረምተ በበዓመት"
    ]
  },
  "ti_ro": {
    "lines": [
      "Sbhet leab leehze kwlu 'alem",
      "Sbhet leweld legebare kwlu ft'ret",
      "Sbhet lemenfesqdus lezeyarhu kremte bebe'amet"
    ]
  },
