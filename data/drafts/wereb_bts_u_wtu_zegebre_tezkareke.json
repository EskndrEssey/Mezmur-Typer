  },
  "ti_ro": {
    "lines": [
      "Bts'u' wtu zegebre tezkareke",
      "Wezets'ehafe mets'hefe gedlke /2/",
      "Ane hubo hywete zele'alem",
      "Weawerso menbere kbr",
      "Ybelo gziebher leewost'atewos"
