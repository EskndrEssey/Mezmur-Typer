  "title": "",
  "wereb": true,
  "ti": {
    "lines": [
      "ሓይሊ ናይ እግዚአብሔር",
      "ፍልጠት ናይ እግዚአብሔር",
      "ጥበብ ናይ እግዚአብሔር",
      "ኣይንመካሕ ብሓይሊ ጉልበትና",
      "እግዚአብሔር'ዩ እቲ መመክሒና"
    ]
  },
  "ti_ro": {
    "lines": [
      "Hayli nay gziebher",
      "Flt'et nay gziebher",
      "T'beb nay gziebher",
      "Aynmekah bhayli gulbetna",
      "Gziebher'yu ti memekhina"
    ]
  },
